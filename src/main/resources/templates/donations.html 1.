
<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donations | AWT Donation Management</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
        }

        header {
            background: #142b4a;
            color: white;
            padding: 22px 6%;
        }

        header h1 {
            font-size: 25px;
            margin-bottom: 8px;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 16px;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }

        main {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .summary {
            background: #dbeafe;
            border-left: 5px solid #2563eb;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .summary p {
            color: #475569;
            margin-bottom: 8px;
        }

        .summary h2 {
            color: #142b4a;
            font-size: 28px;
        }

        .panel {
            background: white;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
        }

        .panel h2 {
            color: #142b4a;
            margin-bottom: 20px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 18px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .field.full {
            grid-column: 1 / -1;
        }

        label {
            font-weight: bold;
            font-size: 14px;
        }

        input, select, textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #cbd5e1;
            border-radius: 7px;
            font-size: 15px;
            background: white;
        }

        textarea {
            min-height: 85px;
            resize: vertical;
        }

        button, .button {
            display: inline-block;
            background: #142b4a;
            color: white;
            border: none;
            border-radius: 7px;
            padding: 12px 18px;
            font-weight: bold;
            text-decoration: none;
            cursor: pointer;
        }

        button:hover, .button:hover {
            background: #25466e;
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 780px;
        }

        th, td {
            text-align: left;
            padding: 14px 12px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        th {
            background: #f8fafc;
            color: #334155;
            font-size: 13px;
        }

        td {
            font-size: 14px;
        }

        .receipt-link {
            display: inline-block;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            background: #eff6ff;
            padding: 8px 11px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            white-space: nowrap;
        }

        .receipt-link:hover {
            background: #dbeafe;
        }

        .empty {
            color: #64748b;
            text-align: center;
            padding: 25px;
        }

        footer {
            text-align: center;
            padding: 25px;
            color: #64748b;
        }

        @media (max-width: 650px) {
            header {
                padding: 20px;
            }

            main {
                padding: 0 12px;
                margin-top: 18px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .field.full {
                grid-column: auto;
            }

            .panel {
                padding: 18px;
            }
        }
    </style>
</head>

<body>
<header>
    <h1>AWT Donation Management System</h1>
    <p>Manage and track donation records</p>

    <nav>
        <a th:href="@{/}">Dashboard</a>
        <a th:href="@{/donors}">Donors</a>
        <a th:href="@{/donations}">Donations</a>
    </nav>
</header>

<main>
    <section class="summary">
        <p>Total donations collected</p>
        <h2>
            ₹<span th:text="${totalAmount}">0.00</span>
        </h2>
    </section>

    <section class="panel">
        <h2>Record a Donation</h2>

        <form th:action="@{/donations/save}" method="post">
            <div class="form-grid">
                <div class="field full">
                    <label for="donorId">Select Donor</label>
                    <select id="donorId" name="donorId" required>
                        <option value="">-- Select a donor --</option>
                        <option th:each="donor : ${donors}"
                                th:value="${donor.id}"
                                th:text="${donor.name + ' (' + donor.email + ')'}">
                        </option>
                    </select>
                </div>

                <div class="field">
                    <label for="amount">Donation Amount (₹)</label>
                    <input id="amount" name="amount" type="number"
                           min="0.01" step="0.01" placeholder="Enter amount"
                           required>
                </div>

                <div class="field">
                    <label for="paymentMode">Payment Method</label>
                    <select id="paymentMode" name="paymentMode" required>
                        <option value="">-- Select payment method --</option>
                        <option value="Cash">Cash</option>
                        <option value="UPI">UPI</option>
                        <option value="Card">Card</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="field full">
                    <label for="purpose">Donation Purpose</label>
                    <textarea id="purpose" name="purpose"
                              placeholder="Enter the purpose of donation"></textarea>
                </div>

                <div class="field full">
                    <button type="submit">Save Donation</button>
                </div>
            </div>
        </form>
    </section>

    <section class="panel">
        <h2>Donation Records</h2>

        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Donation ID</th>
                    <th>Donor</th>
                    <th>Amount</th>
                    <th>Payment Method</th>
                    <th>Purpose</th>
                    <th>Date</th>
                    <th>Receipt</th>
                </tr>
                </thead>

                <tbody>
                <tr th:each="item : ${donations}">
                    <td th:text="${item.id}">1</td>

                    <td>
                        <span th:each="donor : ${donors}"
                              th:if="${donor.id == item.donorId}"
                              th:text="${donor.name}">Donor name</span>
                    </td>

                    <td>
                        ₹<span th:text="${item.amount}">500</span>
                    </td>

                    <td th:text="${item.paymentMode}">UPI</td>

                    <td th:text="${item.purpose != null and !item.purpose.isEmpty() ? item.purpose : 'General Donation'}">
                        General Donation
                    </td>

                    <td th:text="${item.donationDate != null ? item.donationDate : '—'}">
                        —
                    </td>

                    <td>
                        <a class="receipt-link"
                           th:href="@{/receipts/{id}(id=${item.id})}">
                            View Receipt
                        </a>
                    </td>
                </tr>

                <tr th:if="${#lists.isEmpty(donations)}">
                    <td colspan="7" class="empty">
                        No donations recorded yet. Add a donation using the form above.
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
    </section>
</main>

<footer>
    AWT Donation Management System
</footer>
</body>
</html>
